										{
											"referenceName": "ds_landing_json",
											"type": "DatasetReference",
											"parameters": {
												"folderName": "competitor",
												"fileName": {
													"value": "@item().name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ds_raw_json",
											"type": "DatasetReference",
											"parameters": {
												"folderName": "competitor",
												"fileName": {
													"value": "@item().name",
													"type": "Expression"
												}
											}
										}
